# Loopback checkpoint/restore spike actor. Substitute ${SPIKE_IMAGE},
# ${ATEOM_IMAGE}, ${BUCKET_NAME} before applying (see spikes/loopback/build.sh).

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-ws-poc

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: ws-poc-spike
  namespace: ate-demo-ws-poc
  labels:
    workload: ws-poc-spike
spec:
  replicas: 1
  ateomImage: ${ATEOM_IMAGE}

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: loopback-spike
  namespace: ate-demo-ws-poc
spec:
  pauseImage: "registry.k8s.io/pause:3.10.2@sha256:f548e0e8e3dc1896ca956272154dde3314e8cc4fde0a57577ee9fa1c63f5baf4"
  containers:
  - name: spike
    image: ${SPIKE_IMAGE}
    command: ["/spike"]
    readyz:
      httpGet:
        path: /readyz
        port: 80
    volumeMounts:
    - name: data
      mountPath: /data
  workerSelector:
    matchLabels:
      workload: ws-poc-spike
  # onPause: Full is the whole point — the sandbox (both processes + their
  # loopback connection) must be checkpointed with memory and warm-restored.
  snapshotsConfig:
    onPause: Full
    onCommit: Full
    location: gs://${BUCKET_NAME}/ate-demo-ws-poc/
  volumes:
  - name: data
    durableDir: {}
