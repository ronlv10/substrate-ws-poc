# Bolt-over-loopback spike actor. Shares the ws-poc-spike WorkerPool deployed
# by spikes/loopback/actor.yaml. The Slack tokens are fakes — the in-image
# server impersonates Slack, nothing leaves the sandbox.

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: boltloop-spike
  namespace: ate-demo-ws-poc
spec:
  pauseImage: "registry.k8s.io/pause:3.10.2@sha256:f548e0e8e3dc1896ca956272154dde3314e8cc4fde0a57577ee9fa1c63f5baf4"
  containers:
  - name: boltloop
    image: ${SPIKE_IMAGE}
    command: ["/server"]
    env:
    - name: SLACK_APP_TOKEN
      value: "xapp-spike-fake"
    - name: SLACK_BOT_TOKEN
      value: "xoxb-spike-fake"
    - name: NODE_EXTRA_CA_CERTS
      value: "/certs/ca.crt"
    readyz:
      httpGet:
        path: /readyz
        port: 80
    volumeMounts:
    - name: data
      mountPath: /data
  workerSelector:
    matchLabels:
      workload: ws-poc-spike
  snapshotsConfig:
    onPause: Full
    onCommit: Full
    location: gs://${BUCKET_NAME}/ate-demo-ws-poc/
  volumes:
  - name: data
    durableDir: {}
