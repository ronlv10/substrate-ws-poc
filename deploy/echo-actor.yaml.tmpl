apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-ws-poc

---

# ate-api-server resolves the ActorTemplate's secretKeyRef env at golden-snapshot
# / resume time, so it needs read access to the slack-tokens secret. Secret reads
# are intentionally not granted cluster-wide (see manifests/ate-install/
# ate-api-server.yaml); each tenant grants access to its own secret by name.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: ate-api-server-slack-tokens
  namespace: ate-demo-ws-poc
rules:
- apiGroups: [""]
  resources: ["secrets"]
  resourceNames: ["slack-tokens"]
  verbs: ["get"]

---

apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: ate-api-server-slack-tokens
  namespace: ate-demo-ws-poc
subjects:
- kind: ServiceAccount
  name: ate-api-server
  namespace: ate-system
roleRef:
  kind: Role
  name: ate-api-server-slack-tokens
  apiGroup: rbac.authorization.k8s.io

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: ws-poc-echo
  namespace: ate-demo-ws-poc
  labels:
    workload: ws-poc-echo
spec:
  replicas: 2
  ateomImage: ${ATEOM_IMAGE}

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: echo
  namespace: ate-demo-ws-poc
spec:
  pauseImage: "registry.k8s.io/pause:3.10.2@sha256:f548e0e8e3dc1896ca956272154dde3314e8cc4fde0a57577ee9fa1c63f5baf4"
  containers:
  - name: echo
    # ${ECHO_IMAGE} is substituted with the Makefile-pushed digest. substrate
    # ignores image ENV/CMD, so the command and env here are authoritative.
    image: ${ECHO_IMAGE}
    command: ["/app/entrypoint.sh"]
    env:
    - name: SLACK_APP_TOKEN
      valueFrom:
        secretKeyRef:
          name: slack-tokens
          key: app-token
    - name: SLACK_BOT_TOKEN
      valueFrom:
        secretKeyRef:
          name: slack-tokens
          key: bot-token
    # The egress broker Service the actor redirects slack.com to (stable ClusterIP).
    - name: BROKER_SERVICE
      value: "egress-broker.ws-poc.svc.cluster.local"
    # Node ignores SSL_CERT_FILE; NODE_EXTRA_CA_CERTS adds the broker cert (mounted
    # by atelet) to its roots.
    - name: NODE_EXTRA_CA_CERTS
      value: "/etc/ssl/certs/ca-certificates.crt"
    readyz:
      httpGet:
        path: /readyz
        port: 80
    volumeMounts:
    # onPause=Data requires a durable-dir volume to snapshot; the echo actor
    # writes nothing here.
    - name: data
      mountPath: /data
  workerSelector:
    matchLabels:
      workload: ws-poc-echo
  # onPause: Data snapshots the volume, not process memory, so every resume
  # cold-boots the actor. Deliberate: warm-restoring Bolt resumes its dead socket
  # and churns through a reconnect that drops the delivered event; a cold boot
  # starts one clean connection. The actor is stateless, so this costs nothing.
  snapshotsConfig:
    onPause: Data
    onCommit: Data
    location: gs://${BUCKET_NAME}/ate-demo-ws-poc/
  volumes:
  - name: data
    durableDir: {}
