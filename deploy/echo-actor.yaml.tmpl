apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-ws-poc

---

# ate-api-server resolves the ActorTemplate's secretKeyRef env at golden-snapshot
# / resume time, so it needs read access to the slack-tokens secret. Secret reads
# are intentionally not granted cluster-wide (see manifests/ate-install/
# ate-api-server.yaml); each tenant grants access to its own secret by name.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: ate-api-server-slack-tokens
  namespace: ate-demo-ws-poc
rules:
- apiGroups: [""]
  resources: ["secrets"]
  resourceNames: ["slack-tokens"]
  verbs: ["get"]

---

apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: ate-api-server-slack-tokens
  namespace: ate-demo-ws-poc
subjects:
- kind: ServiceAccount
  name: ate-api-server
  namespace: ate-system
roleRef:
  kind: Role
  name: ate-api-server-slack-tokens
  apiGroup: rbac.authorization.k8s.io

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: ws-poc-echo
  namespace: ate-demo-ws-poc
  labels:
    workload: ws-poc-echo
spec:
  replicas: 2
  ateomImage: ${ATEOM_IMAGE}

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: echo
  namespace: ate-demo-ws-poc
spec:
  pauseImage: "registry.k8s.io/pause:3.10.2@sha256:f548e0e8e3dc1896ca956272154dde3314e8cc4fde0a57577ee9fa1c63f5baf4"
  containers:
  - name: echo
    # The Bolt (Node) actor image, built + pinned by the Makefile (${ECHO_IMAGE}
    # is substituted with the pushed digest). substrate ignores image ENV/CMD, so
    # the command and env below are authoritative.
    image: ${ECHO_IMAGE}
    # entrypoint.sh resolves BROKER_SERVICE and points slack.com at it via
    # /etc/hosts (per-actor; the broker is never redirected), then starts Bolt.
    command: ["/app/entrypoint.sh"]
    env:
    - name: SLACK_APP_TOKEN
      valueFrom:
        secretKeyRef:
          name: slack-tokens
          key: app-token
    - name: SLACK_BOT_TOKEN
      valueFrom:
        secretKeyRef:
          name: slack-tokens
          key: bot-token
    # The egress broker Service the actor redirects slack.com to (stable ClusterIP).
    - name: BROKER_SERVICE
      value: "egress-broker.ws-poc.svc.cluster.local"
    # Make Node trust the broker CA that atelet mounts over the system bundle.
    # Node ignores SSL_CERT_FILE; it honors NODE_EXTRA_CA_CERTS (adds to its roots).
    - name: NODE_EXTRA_CA_CERTS
      value: "/etc/ssl/certs/ca-certificates.crt"
    readyz:
      httpGet:
        path: /readyz
        port: 80
    volumeMounts:
    # A durable-dir volume so onPause=Data has something to snapshot (the DATA
    # snapshot requires at least one durable-dir volume). The echo actor writes
    # nothing here — it exists only to satisfy the Data-snapshot path.
    - name: data
      mountPath: /data
  workerSelector:
    matchLabels:
      workload: ws-poc-echo
  # onPause: Data snapshots only the durable-dir volume, NOT the process memory —
  # so every resume COLD-BOOTS the actor from the image instead of warm-restoring
  # a frozen process. Deliberate: warm-restoring the Bolt Socket Mode client
  # resumes its dead external socket and churns through a primary/secondary
  # reconnect that silently drops the delivered event. A fresh cold boot starts
  # Bolt on one clean connection and dispatches reliably. The actor is stateless,
  # so losing the process memory costs nothing.
  snapshotsConfig:
    onPause: Data
    onCommit: Data
    location: gs://${BUCKET_NAME}/ate-demo-ws-poc/
  volumes:
  - name: data
    durableDir: {}
