#
# The echo actor: a normal Slack Socket Mode bot, run as a suspendable actor.
# Apply with `ko apply -f` after substituting ${BUCKET_NAME}. It expects a
# Secret named `slack-tokens` in this namespace holding the app-level and bot
# tokens:
#   kubectl -n ate-demo-ws-poc create secret generic slack-tokens \
#       --from-literal=app-token=xapp-... --from-literal=bot-token=xoxb-...

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-ws-poc

---

# ate-api-server resolves the ActorTemplate's secretKeyRef env at golden-snapshot
# / resume time, so it needs read access to the slack-tokens secret. Secret reads
# are intentionally not granted cluster-wide (see manifests/ate-install/
# ate-api-server.yaml); each tenant grants access to its own secret by name.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: ate-api-server-slack-tokens
  namespace: ate-demo-ws-poc
rules:
- apiGroups: [""]
  resources: ["secrets"]
  resourceNames: ["slack-tokens"]
  verbs: ["get"]

---

apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: ate-api-server-slack-tokens
  namespace: ate-demo-ws-poc
subjects:
- kind: ServiceAccount
  name: ate-api-server
  namespace: ate-system
roleRef:
  kind: Role
  name: ate-api-server-slack-tokens
  apiGroup: rbac.authorization.k8s.io

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: ws-poc-echo
  namespace: ate-demo-ws-poc
  labels:
    workload: ws-poc-echo
spec:
  replicas: 2
  ateomImage: ${ATEOM_IMAGE}

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: echo
  namespace: ate-demo-ws-poc
spec:
  pauseImage: "registry.k8s.io/pause:3.10.2@sha256:f548e0e8e3dc1896ca956272154dde3314e8cc4fde0a57577ee9fa1c63f5baf4"
  containers:
  - name: echo
    # The Bolt (Node) actor image, built + pinned by the Makefile (${ECHO_IMAGE}
    # is substituted with the pushed digest). substrate ignores image ENV/CMD, so
    # the command and env below are authoritative.
    image: ${ECHO_IMAGE}
    # The local proxy is PID 1; it binds loopback :443 and :80 first, then
    # spawns the stock Bolt agent. An empty --broker-address runs the proxy
    # standalone (Web API stubs + synthetic events) for phase-1 testing.
    command: ["/local-proxy", "--broker-address=${BROKER_ADDRESS}", "--", "node", "/app/app.js"]
    env:
    - name: SLACK_APP_TOKEN
      valueFrom:
        secretKeyRef:
          name: slack-tokens
          key: app-token
    - name: SLACK_BOT_TOKEN
      valueFrom:
        secretKeyRef:
          name: slack-tokens
          key: bot-token
    # Trust the image-baked proxy CA. Node ignores SSL_CERT_FILE; it honors
    # NODE_EXTRA_CA_CERTS (adds to its roots).
    - name: NODE_EXTRA_CA_CERTS
      value: "/etc/local-proxy/ca/proxy-ca.crt"
    readyz:
      httpGet:
        path: /readyz
        port: 80
    volumeMounts:
    - name: data
      mountPath: /data
  workerSelector:
    matchLabels:
      workload: ws-poc-echo
  # onPause: Full checkpoints the whole sandbox — both processes AND their
  # loopback connection — and warm-restores it with memory intact. This is the
  # point of the sidecar design: the agent↔proxy socket survives resume, only
  # the proxy's broker stream reconnects. The agent's Socket Mode client still
  # reconnects LOCALLY after a restore (its pong-staleness check uses the wall
  # clock, which jumps); the proxy holds event delivery until that settles.
  snapshotsConfig:
    onPause: Full
    onCommit: Full
    location: gs://${BUCKET_NAME}/ate-demo-ws-poc/
  volumes:
  - name: data
    durableDir: {}
