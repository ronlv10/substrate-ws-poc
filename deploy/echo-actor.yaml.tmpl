# The echo actor: a stock Slack Socket Mode bot plus its local proxy, run as a
# suspendable actor. Substitute the ${...} vars (the Makefile does). Needs a
# `slack-tokens` secret in this namespace (app-token, bot-token).

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-ws-poc

---

# ate-api-server resolves the ActorTemplate's secretKeyRef env at golden-snapshot
# / resume time, so it needs read access to the slack-tokens secret. Secret reads
# are intentionally not granted cluster-wide (see manifests/ate-install/
# ate-api-server.yaml); each tenant grants access to its own secret by name.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: ate-api-server-slack-tokens
  namespace: ate-demo-ws-poc
rules:
- apiGroups: [""]
  resources: ["secrets"]
  resourceNames: ["slack-tokens"]
  verbs: ["get"]

---

apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: ate-api-server-slack-tokens
  namespace: ate-demo-ws-poc
subjects:
- kind: ServiceAccount
  name: ate-api-server
  namespace: ate-system
roleRef:
  kind: Role
  name: ate-api-server-slack-tokens
  apiGroup: rbac.authorization.k8s.io

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: ws-poc-echo
  namespace: ate-demo-ws-poc
  labels:
    workload: ws-poc-echo
spec:
  replicas: 2
  ateomImage: ${ATEOM_IMAGE}

---

apiVersion: ate.dev/v1alpha1
kind: ActorTemplate
metadata:
  name: echo
  namespace: ate-demo-ws-poc
spec:
  pauseImage: "registry.k8s.io/pause:3.10.2@sha256:f548e0e8e3dc1896ca956272154dde3314e8cc4fde0a57577ee9fa1c63f5baf4"
  containers:
  - name: echo
    # substrate ignores image ENV/CMD, so command and env here are authoritative.
    image: ${ECHO_IMAGE}
    # The local proxy is PID 1; it binds loopback :443 and :80, then spawns the
    # agent. Empty --broker-address runs it standalone (stubs + synthetic events).
    command: ["/local-proxy", "--broker-address=${BROKER_ADDRESS}", "--", "node", "/app/app.js"]
    env:
    - name: SLACK_APP_TOKEN
      valueFrom:
        secretKeyRef:
          name: slack-tokens
          key: app-token
    - name: SLACK_BOT_TOKEN
      valueFrom:
        secretKeyRef:
          name: slack-tokens
          key: bot-token
    # Trust the image-baked proxy CA. Node ignores SSL_CERT_FILE; it honors
    # NODE_EXTRA_CA_CERTS (adds to its roots).
    - name: NODE_EXTRA_CA_CERTS
      value: "/etc/local-proxy/ca/proxy-ca.crt"
    readyz:
      httpGet:
        path: /readyz
        port: 80
    volumeMounts:
    - name: data
      mountPath: /data
  workerSelector:
    matchLabels:
      workload: ws-poc-echo
  # onPause: Full warm-restores the whole sandbox with memory: the agent<->proxy
  # loopback socket survives, only the proxy's broker stream reconnects.
  snapshotsConfig:
    onPause: Full
    onCommit: Full
    location: gs://${BUCKET_NAME}/ate-demo-ws-poc/
  volumes:
  - name: data
    durableDir: {}
